#!/usr/bin/env bash
# Start pi inside a macOS sandbox (sandbox-exec).
#
# Sandbox policy (inverted model: allow-by-default, deny specific dangers):
#   * File reads  : allowed anywhere (binaries, dylibs, dotfiles like
#                  ~/.gitconfig, ~/.npmrc, ~/.ssh for git-over-ssh, API keys).
#   * File writes : DENIED everywhere except the working directory, temp
#                  dirs (/tmp, /var/tmp, $TMPDIR), and /dev (null, tty, ...).
#   * Network     : allowed (outbound TCP/UDP + inbound on ephemeral ports)
#                  — required for LLM provider APIs.
#   * Processes   : exec/fork allowed (pi's bash tool runs arbitrary commands).
#   * IPC/Mach    : allowed (allow-default covers it; needed by cfprefsd,
#                  opendirectoryd, etc. at startup).
#
# WHY allow-default instead of deny-default?
#   sandbox-exec has an internal allocator bug (LowLevelAlloc arithmetic
#   overflow) that crashes when tracing high-volume processes like node. With
#   deny-default, *every* syscall is checked against the rule list; with
#   allow-default, only the (rare) file-write operations are checked, which
#   keeps the tracing overhead low enough to avoid the crash. The practical
#   result is the same for our threat model: writes are confined to the
#   working directory.
#
# Profile location: ./.pi/sandbox.sb
# If it doesn't exist, a default is generated (see below). Edit it freely;
# pi-sandbox will not overwrite an existing profile.

set -euo pipefail

PROFILE_DIR=".pi"
PROFILE="${PROFILE_DIR}/sandbox.sb"

if [[ ! -f "$PROFILE" ]]; then
  mkdir -p "$PROFILE_DIR"
  cat > "$PROFILE" <<'SB'
;; Default pi sandbox profile.
;; Generated by pi-sandbox. Edit freely; it will not be overwritten.
;;
;; Model: allow everything by default, then deny file writes outside the
;; working directory and temp dirs. See the wrapper script for rationale.

(version 1)
(allow default)

;; ---- File writes ---------------------------------------------------------
;; Deny all writes system-wide, then re-allow the paths we need. Rules are
;; last-match-wins, so order matters: broad deny first, specific allows after.
;; WORK_DIR and TMP_DIR are passed in as sandbox parameters (-D) and MUST be
;; canonical (realpath) paths, because sandbox resolves symlinks before
;; matching (e.g. /var/folders -> /private/var/folders).
(deny file-write* (subpath "/"))
(allow file-write* (subpath (param "WORK_DIR")))
(allow file-write* (subpath "/tmp"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/var/tmp"))
(allow file-write* (subpath "/private/var/tmp"))
(allow file-write* (subpath (param "HOME_DIR") "/.pi/agent/settings.json.lock"))
(allow file-write* (subpath (param "HOME_DIR") "/.pi/agent/sessions"))
(allow file-write* (subpath (param "TMP_DIR")))
;; Editor state: nvim writes swap, ShaDa, undo, and plugin logs under
;; ~/.local (state + share) and ~/.cache; other editors cache similarly.
;; Without these, $EDITOR children of the agent hit E303/E886 and plugin
;; load failures when launched from the sandboxed pi process.
;;
;; Narrowed to these two subpaths rather than the whole home: `subpath`
;; matches recursively, so allowing HOME_DIR wholesale would also permit
;; writes to ~/.ssh, ~/.zshrc, ~/Library/LaunchAgents (persistence), etc.
;; — defeating the sandbox's write confinement. Add more subpaths here if
;; a future tool needs them.
;;
;; sandbox-exec does not expand ~ or $HOME in profiles (the profile is not
;; shell-parsed) and has no path-joining, so each writable subpath is
;; passed as its own -D param from pi-sandbox, matching the
;; WORK_DIR/TMP_DIR canonical-path convention.
(allow file-write* (subpath (param "LOCAL_DIR")))
(allow file-write* (subpath (param "CACHE_DIR")))
;; /dev is its own filesystem; allow writes there so shell redirections to
;; /dev/null, /dev/tty, etc. keep working. Reads already allowed by default.
(allow file-write* (subpath "/dev"))

;; TODO (interview answers):
;;   * If an editor/tool writes under ~/.config (rare; nvim mostly reads it),
;;     add a CONFIG_DIR param + allow here rather than re-widening to HOME.
;;   * Allow writes under ~/Library/Preferences (cfprefsd)?    add a subpath.
;;   * Restrict network to specific provider hosts?            add deny rules:
;;       (deny network-outbound (remote tcp) (require-not (remote tcp "api.anthropic.com:443")))
;;   * Whitelist executables instead of allow process-exec?   replace
;;     (allow default) for process-exec with (allow process-exec (subpath ...))
SB
  echo "pi-sandbox: created default profile at $PROFILE" >&2
fi

# Portable realpath (macOS BSD readlink lacks -f).
_realpath() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }

# Resolve the REAL pi binary. This wrapper is often installed as `pi` itself
# (to shadow the real one in PATH), so a naive `pi "$@"` would recurse into
# this script forever. Walk PATH and pick the first executable named `pi`
# whose canonical path differs from this script's.
SELF="$(_realpath "$0")"
REAL_PI=""
IFS=':' read -ra _PATHS <<< "${PATH:-}"
for _dir in "${_PATHS[@]}"; do
  [[ -n "$_dir" ]] || continue
  _cand="$_dir/pi"
  [[ -x "$_cand" ]] || continue
  _real="$(_realpath "$_cand")"
  [[ "$_real" != "$SELF" ]] || continue
  REAL_PI="$_cand"
  break
done
if [[ -z "$REAL_PI" ]]; then
  echo "pi-sandbox: could not locate the real 'pi' binary in PATH (excluding myself at $SELF)" >&2
  exit 1
fi

# Resolve canonical paths: sandbox matches against real paths (symlinks
# resolved), so /var/folders must become /private/var/folders, etc.
WORK_DIR="$(pwd -P)"
TMP_DIR="$(_realpath "${TMPDIR:-/var/tmp}")"

exec sandbox-exec \
  -D WORK_DIR="$WORK_DIR" \
  -D TMP_DIR="$TMP_DIR" \
  -D HOME_DIR="$(_realpath "$HOME")" \
  -D LOCAL_DIR="$(_realpath "$HOME/.local")" \
  -D CACHE_DIR="$(_realpath "$HOME/.cache")" \
  -f "$PROFILE" \
  "$REAL_PI" "$@"
